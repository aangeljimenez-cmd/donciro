---
import MainLayout from "../layouts/MainLayout.astro";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout title="Contáctanos">
  <Navbar />

  <section class="contacto">
    <h1>¡Contáctanos!</h1>
    <p class="subtitulo">
      Estamos felices de atenderte. Síguenos en nuestras redes sociales o
      escríbenos.
    </p>

    <div class="redes">
      <a
        href="https://wa.me/56950057760?text=Hola%20Don%20Ciro%2C%20quisiera%20más%20información%20sobre%20sus%20productos"
        target="_blank"
        class="card whatsapp"
      >
        <div class="icono">📱</div>
        <h2>WhatsApp</h2>
        <p>+56 9 5005 7760</p>
      </a>

      <a
        href="https://www.instagram.com/donciro2026/"
        target="_blank"
        class="card instagram"
      >
        <div class="icono">
          <img
            src="https://static.wikia.nocookie.net/youtubepedia/images/1/1e/Instagram-.png/revision/latest?cb=20250619175353&path-prefix=es"
            style="width: 70px;border-radius:10px;"
            alt=""
          />
        </div>
        <h2>Instagram</h2>
        <p>@DonCiro</p>
      </a>

      <a
        href="https://mail.google.com/mail/?view=cm&fs=1&to=donciro.contactanos@gmail.com"
        target="_blank"
        class="card gmail"
      >
        <div class="icono">✉️</div>
        <h2>Gmail</h2>
        <p>DonCiro@gmail.com</p>
      </a>
    </div>
  </section>
</MainLayout>

<h2 class="frase">
  🧀 ¡Síguenos y descubre nuestras mejores ofertas, promociones y productos
  frescos todos los días! 
</h2>

<Footer />

<style>
  .contacto {
    min-height: 80vh;
    padding: 60px 20px;
    text-align: center;
    background: linear-gradient(135deg, #EDF6F5, #D9EBF0);
  }

  .contacto h1 {
    font-size: clamp(1.8rem, 7vw, 3rem);
    color: var(--azul-dark);
    margin-bottom: 10px;
  }

  .subtitulo {
    font-size: 1.2rem;
    margin-bottom: 50px;
    color: #555;
  }

  .redes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
    max-width: 1100px;
    margin: auto;
  }

  .card {
    text-decoration: none;
    color: white;
    border-radius: 25px;
    padding: 40px 20px;
    transition: 0.4s;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  }

  .card:hover {
    transform: translateY(-12px) scale(1.05);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
  }

  .icono {
    font-size: clamp(48px, 10vw, 70px);
    margin-bottom: 20px;
    animation: flotar 2s infinite ease-in-out;
  }

  .card h2 {
    font-size: 2rem;
    margin-bottom: 10px;
  }

  .card p {
    font-size: 1.1rem;
  }

  .whatsapp {
    background: linear-gradient(135deg, #25D366, #128C7E);
  }

  .instagram {
    background: linear-gradient(135deg, #833AB4, #C13584, #F56040, #FCAF45);
  }

  .facebook {
    background: linear-gradient(135deg, #1877f2, #0d47a1);
  }

  .gmail {
    background: linear-gradient(135deg, #EA4335, #B31412);
  }

  @keyframes flotar {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  .card {
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: "";
    position: absolute;
    width: 60px;
    height: 250%;
    background: rgba(255, 255, 255, 0.35);
    top: -80%;
    left: -120px;
    transform: rotate(30deg);
    transition: 0.8s;
  }

  .card:hover::before {
    left: 140%;
  }

  .contacto h1 {
    font-size: clamp(1.8rem, 7vw, 4rem);
    font-weight: bold;
    background: linear-gradient(90deg, var(--azul-dark), var(--azul-acento), var(--oro));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: titulo 4s linear infinite;
  }

  @keyframes titulo {
    from {
      background-position: 0%;
    }
    to {
      background-position: 200%;
    }
  }

  .frase {
    color: var(--azul-dark);
    font-size: clamp(1.1rem, 4vw, 1.5rem);
    margin: 40px auto;
    padding: 0 20px;
    animation: latido 2s infinite;
  }

  @keyframes latido {
    50% {
      transform: scale(1.05);
    }
  }

  .contacto {
    background:
      radial-gradient(circle at top left, #A8DAD5 0%, transparent 30%),
      radial-gradient(circle at bottom right, #E7C4A1 0%, transparent 35%),
      linear-gradient(135deg, #F7FAF9, #E5F0F1);
  }
</style>