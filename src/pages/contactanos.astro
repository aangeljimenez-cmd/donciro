---
import MainLayout from "../layouts/MainLayout.astro";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout title="Contáctanos">
  <Navbar />

  <section class="contacto">
    <h1>¡Contáctanos!</h1>
    <p class="subtitulo">
      Estamos felices de atenderte. Síguenos en nuestras redes sociales o
      escríbenos.
    </p>

    <div class="redes">
      <a href="https://wa.me/+56950057760" target="_blank" class="card whatsapp">
        <div class="icono">📱</div>
        <h2>WhatsApp</h2>
        <p>+56 9 5005 7760</p>
      </a>

      <a href="https://www.instagram.com/donciro2026/" target="_blank" class="card instagram">
        <div class="icono"><img src="https://static.wikia.nocookie.net/youtubepedia/images/1/1e/Instagram-.png/revision/latest?cb=20250619175353&path-prefix=es" style="width: 70px;border-radius:10px;" alt=""></div>
        <h2>Instagram</h2>
        <p>@DonCiro</p>
      </a>

      <a href="mailto:DonCiro.Contactanos@gmail.com" class="card gmail">
        <div class="icono">✉️</div>
        <h2>Gmail</h2>
        <p>DonCiro@gmail.com</p>
      </a>
    </div>
  </section>

  <h2 class="frase">
    🧀 ¡Síguenos y descubre nuestras mejores ofertas, promociones y productos
    frescos todos los días! 🥛
  </h2>

  <Footer />
</MainLayout>

<style>
  .contacto {
    min-height: 80vh;
    padding: 60px 20px;
    text-align: center;
    background: linear-gradient(135deg, #fff9d6, #d9f7be);
  }

  .contacto h1 {
    font-size: 3rem;
    color: #2e7d32;
    margin-bottom: 10px;
  }

  .subtitulo {
    font-size: 1.2rem;
    margin-bottom: 50px;
    color: #555;
  }

  .redes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
    max-width: 1100px;
    margin: auto;
  }

  .card {
    text-decoration: none;
    color: white;
    border-radius: 25px;
    padding: 40px 20px;
    transition: 0.4s;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
  }

  .card:hover {
    transform: translateY(-12px) scale(1.05);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
  }

  .icono {
    font-size: 70px;
    margin-bottom: 20px;
    animation: flotar 2s infinite ease-in-out;
  }

  .card h2 {
    font-size: 2rem;
    margin-bottom: 10px;
  }

  .card p {
    font-size: 1.1rem;
  }

  .whatsapp {
    background: linear-gradient(135deg, #25d366, #128c7e);
  }

  .instagram {
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
  }

  .facebook {
    background: linear-gradient(135deg, #1877f2, #0d47a1);
  }

  .gmail {
    background: linear-gradient(135deg, #ea4335, #ff7043);
  }

  @keyframes flotar {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  .card {
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: "";
    position: absolute;
    width: 60px;
    height: 250%;
    background: rgba(255, 255, 255, 0.35);
    top: -80%;
    left: -120px;
    transform: rotate(30deg);
    transition: 0.8s;
  }

  .card:hover::before {
    left: 140%;
  }

  .contacto h1 {
    font-size: 4rem;
    font-weight: bold;
    background: linear-gradient(90deg, #2e7d32, #ffd600, #43a047);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: titulo 4s linear infinite;
  }

  @keyframes titulo {
    from {
      background-position: 0%;
    }
    to {
      background-position: 200%;
    }
  }

  .frase {
    color: #2e7d32;
    font-size: 1.5rem;
    margin: 40px auto;
    animation: latido 2s infinite;
  }

    @keyframes latido {
      50% {
        transform: scale(1.05);
      }
    }

  .contacto {
    background:
      radial-gradient(circle at top left, #ffe95b 0%, transparent 30%),
      radial-gradient(circle at bottom right, #66bb6a 0%, transparent 35%),
      linear-gradient(135deg, #fffbe6, #e8f5e9);
  }
</style>
