---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
import { pool } from "../lib/db.js";

const [productos] = await pool.query(
  `SELECT p.id, p.name, p.precio, p.imagen, u.name AS unidad, c.name AS categoria
   FROM productos p
   JOIN categoria c ON p.id_cat = c.id
   JOIN unidad_medida u ON p.id_umedida = u.id
   WHERE p.disponible = 1 AND p.stock > 0
   ORDER BY p.name`
);
---

<MainLayout title="Productos">

<Navbar />
<input
  type="text"
  placeholder="🔍 Buscar un producto..."
  class="buscar"
  id="buscador-productos"
/>
<Card></Card>

<div class="grid-todos-productos" id="grid-productos">
  {productos.map((p) => (
    <div class="producto" data-name={p.name.toLowerCase()}>
      <img src={p.imagen || "/src/img/images.jfif"} alt={p.name} />
      <div class="producto-info">
        <h3>{p.name}</h3>
        <p>{p.categoria} · {p.unidad}</p>
        <p class="precio">${Number(p.precio).toLocaleString('es-CL')}</p>

        {p.unidad === 'kg' ? (
          <div class="cantidad-selector">
            <select class="select-gramos" data-id={p.id}>
              <option value="250">250 gr</option>
              <option value="500">500 gr</option>
              <option value="750">750 gr</option>
              <option value="1000" selected>1 kg</option>
              <option value="1500">1,5 kg</option>
              <option value="2000">2 kg</option>
            </select>
            <button class="btn-comprar" data-id={p.id} data-unidad="kg">Agregar</button>
          </div>
        ) : (
          <button class="btn-comprar" data-id={p.id} data-unidad={p.unidad}>Comprar</button>
        )}
      </div>
    </div>
  ))}
</div>

<p id="sin-resultados" style="display:none; text-align:center; margin:30px;">
  No se encontraron productos.
</p>

<Footer />

</MainLayout>

<script>
  import { addToCart } from "../lib/cart.js";

  const input = document.getElementById("buscador-productos");
  const grid = document.getElementById("grid-productos");
  const sinResultados = document.getElementById("sin-resultados");
  const items = Array.from(grid.querySelectorAll(".producto"));

  input.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visibles = 0;

    items.forEach((item) => {
      const coincide = item.dataset.name.includes(query);
      item.style.display = coincide ? "" : "none";
      if (coincide) visibles++;
    });

    sinResultados.style.display = visibles === 0 ? "block" : "none";
  });

  document.addEventListener("click", (e) => {
    if (e.target.classList.contains("btn-comprar")) {
      const id = Number(e.target.dataset.id);
      const esKg = e.target.dataset.unidad === "kg";
      let cantidad = 1;

      if (esKg) {
        const select = document.querySelector(`.select-gramos[data-id="${id}"]`);
        const gramos = Number(select.value);
        cantidad = gramos / 1000;
      }

      addToCart(id, cantidad);
      const original = e.target.textContent;
      e.target.textContent = "¡Agregado!";
      e.target.disabled = true;
      setTimeout(() => {
        e.target.textContent = original;
        e.target.disabled = false;
      }, 1000);
    }
  });
</script>

<style>

.buscar{
width:70%;
max-width:600px;
padding:18px;
border-radius:40px;
border:none;
box-shadow:0 5px 20px rgba(0,0,0,.2);
font-size:18px;
margin:40px auto;
display:block;
}

.grid-todos-productos{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
gap:30px;
padding:0 20px 60px;
}

.producto{
background:white;
border-radius:25px;
overflow:hidden;
box-shadow:0 15px 35px rgba(0,0,0,.15);
transition:.4s;
}

.producto:hover{
transform:translateY(-15px) scale(1.05);
box-shadow:0 25px 50px rgba(0,0,0,.30);
}

.producto img{
width:100%;
height:250px;
object-fit:cover;
transition:.5s;
}

.producto:hover img{
transform:scale(1.15);
}

.producto-info{
padding:15px;
}

.producto-info .precio{
font-weight:bold;
font-size:1.2rem;
margin-top:5px;
}

.cantidad-selector{
display:flex;
gap:8px;
margin-top:10px;
}

.select-gramos{
flex:1;
padding:8px;
border-radius:6px;
border:1px solid #ccc;
}

.producto button{
background:#30af25;
color:white;
border:none;
padding:15px;
width:100%;
font-size:18px;
cursor:pointer;
transition:.3s;
}

.producto button:hover{
background:#ffd600;
color:black;
}

body{
background:
radial-gradient(circle at top left,#ffdd00 0%,transparent 45%),
radial-gradient(circle at bottom right,#00f7ff 0%,transparent 55%),
linear-gradient(135deg,#fffde7,#f1f8e9);
}
</style>