---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Services from "../components/Services.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
---

<MainLayout title="Productos">

<Navbar />
<input
type="text"
placeholder="🔍 Buscar un producto..."
class="buscar">
<Card></Card>
<Footer />

</MainLayout>


<style>

.buscar{

width:70%;

max-width:600px;

padding:18px;

border-radius:40px;

border:none;

box-shadow:0 5px 20px rgba(0,0,0,.2);

font-size:18px;

margin:40px auto;

display:block;

}

.producto{

background:white;
border-radius:25px;
overflow:hidden;

box-shadow:0 15px 35px rgba(0,0,0,.15);

transition:.4s;

cursor:pointer;

}

.producto:hover{

transform:
translateY(-15px)
scale(1.05);

box-shadow:0 25px 50px rgba(0,0,0,.30);

}

.producto img{

width:100%;
height:250px;
object-fit:cover;

transition:.5s;

}

.producto:hover img{

transform:scale(1.15);

}

.producto button{

background:#30af25;

color:white;

border:none;

padding:15px;

width:100%;

font-size:18px;

cursor:pointer;

transition:.3s;

}

.producto button:hover{

background:#ffd600;
color:black;

}

body{

background:

radial-gradient(circle at top left,#ffdd00 0%,transparent 45%),

radial-gradient(circle at bottom right,#00f7ff 0%,transparent 55%),

linear-gradient(135deg,#fffde7,#f1f8e9);

}
</style>