---
import Layout from '../layouts/MainLayout.astro';
import { listarPedidos, obtenerItemsPedido } from '../lib/pedidos.js';
import { estaAutorizado } from '../lib/auth.js';
import PanelNavbar from '../components/PanelNavbar.astro';

const autorizado = estaAutorizado(Astro.request);

if (!autorizado) {
  Astro.response.status = 401;
  Astro.response.headers.set('WWW-Authenticate', 'Basic realm="Panel proveedor"');
}

const filtroEstado = Astro.url.searchParams.get('estado') || '';
const filtroDesde = Astro.url.searchParams.get('desde') || '';
const filtroHasta = Astro.url.searchParams.get('hasta') || '';

let pedidos = [];
if (autorizado) {
  const base = await listarPedidos();
  let filtrados = base;

  if (filtroEstado) {
    filtrados = filtrados.filter((p) => p.estado === filtroEstado);
  }
  if (filtroDesde) {
    const desde = new Date(`${filtroDesde}T00:00:00`);
    filtrados = filtrados.filter((p) => new Date(p.created_at) >= desde);
  }
  if (filtroHasta) {
    const hasta = new Date(`${filtroHasta}T23:59:59`);
    filtrados = filtrados.filter((p) => new Date(p.created_at) <= hasta);
  }

  pedidos = await Promise.all(
    filtrados.map(async (p) => ({ ...p, items: await obtenerItemsPedido(p.id) }))
  );
}

const pedidosPendientes = pedidos.filter((p) => p.estado !== 'entregado');
const hayFiltrosActivos = !!(filtroEstado || filtroDesde || filtroHasta);

function formatearMonto(monto) {
  return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP' }).format(monto);
}
---

<Layout title="Pedidos - Panel proveedor">
  {!autorizado ? (
    <p style="text-align:center; margin:60px;">Acceso restringido.</p>
  ) : (
    <div class="panel-container">
      <PanelNavbar />
      <h1 class="titulo-seccion">Pedidos</h1>

      <form class="filtros-bar" method="get">
        <select name="estado" class="filtro-select">
          <option value="" selected={filtroEstado === ''}>Todos los estados</option>
          <option value="pendiente" selected={filtroEstado === 'pendiente'}>Pendiente</option>
          <option value="en_preparacion" selected={filtroEstado === 'en_preparacion'}>En preparación</option>
          <option value="en_ruta" selected={filtroEstado === 'en_ruta'}>En ruta</option>
          <option value="entregado" selected={filtroEstado === 'entregado'}>Entregado</option>
        </select>
        <label class="filtro-fecha">
          Desde
          <input type="date" name="desde" value={filtroDesde} />
        </label>
        <label class="filtro-fecha">
          Hasta
          <input type="date" name="hasta" value={filtroHasta} />
        </label>
        <button type="submit" class="btn-filtrar">Filtrar</button>
        {hayFiltrosActivos && <a href="/pedidos" class="btn-limpiar-filtros">Limpiar</a>}
      </form>

      {pedidosPendientes.length > 0 && (
        <div class="ruta-entrega">
          <h2>Ruta de entrega (no entregados)</h2>
          <ol>
            {pedidosPendientes.map((p) => (
              <li>
                <strong>#{p.id}</strong> — {p.nombre} — {p.direccion}
                (<a href={`tel:${p.telefono}`}>{p.telefono}</a>)
              </li>
            ))}
          </ol>
        </div>
      )}

      {pedidos.length === 0 && (
        <p class="sin-pedidos">No hay pedidos que coincidan con estos filtros.</p>
      )}

      <div class="pedidos-lista">
        {pedidos.map((p) => (
          <div class="pedido-card" data-estado={p.estado}>
            <div class="pedido-card__header">
              <span class="pedido-card__id">Ticket #{p.id}</span>
              <span class={`pedido-card__estado pedido-card__estado--${p.estado}`}>{p.estado}</span>
            </div>

            <p><strong>Cliente:</strong> {p.nombre} ({p.telefono}) {p.rut && <span>— RUT {p.rut}</span>}</p>
            <p><strong>Entrega:</strong> {p.direccion}</p>
            <p><strong>Fecha:</strong> {new Date(p.created_at).toLocaleString('es-CL')}</p>

            <div class="pedido-card__items">
              {p.items.map((i) => {
                const esPeso = i.unidad === 'kg' || i.unidad === 'litro';
                return (
                  <div class="item-pesaje" data-item-id={i.id}>
                    <span>{i.producto_nombre}</span>
                    <span>
                      Pedido: {esPeso ? `${(Number(i.cantidad) * 1000).toFixed(0)} g/ml` : `${i.cantidad} un.`}
                    </span>
                    {esPeso ? (
                      <span class="pesaje-input">
                        Real:
                        <input
                          type="number"
                          class="input-cantidad-real"
                          data-item-id={i.id}
                          step="1"
                          min="0"
                          value={i.cantidad_real !== null ? Number(i.cantidad_real) * 1000 : (Number(i.cantidad) * 1000).toFixed(0)}
                        /> g/ml
                      </span>
                    ) : (
                      <span>${Number(i.subtotal).toLocaleString('es-CL')}</span>
                    )}
                  </div>
                );
              })}
              {p.items.some((i) => i.unidad === 'kg' || i.unidad === 'litro') && (
                <button class="btn-guardar-pesaje" data-pedido-id={p.id}>Guardar pesaje real</button>
              )}
            </div>

            <p>Subtotal: {formatearMonto(p.subtotal)}</p>
            {Number(p.descuento_pct) > 0 && (
              <p>Descuento ({p.descuento_pct}%): -{formatearMonto(p.descuento_monto)}</p>
            )}
            <p class="pedido-card__total">Total: {formatearMonto(p.total)}</p>

            <div class="pedido-card__acciones">
              <button class="btn-estado" data-id={p.id} data-estado="en_preparacion">En preparación</button>
              <button class="btn-estado" data-id={p.id} data-estado="en_ruta">En ruta</button>
              <button class="btn-estado" data-id={p.id} data-estado="entregado">Entregado</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}
</Layout>

<script>
  document.addEventListener('click', async (e) => {
    if (e.target.classList.contains('btn-estado')) {
      const id = Number(e.target.dataset.id);
      const estado = e.target.dataset.estado;
      await fetch('/api/pedidos/estado', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, estado }),
      });
      location.reload();
    }

    if (e.target.classList.contains('btn-guardar-pesaje')) {
      const pedidoCard = e.target.closest('.pedido-card');
      const inputs = pedidoCard.querySelectorAll('.input-cantidad-real');
      const items = Array.from(inputs).map((input) => ({
        pedido_item_id: Number(input.dataset.itemId),
        cantidad_real: Number(input.value) / 1000,
      }));

      const res = await fetch('/api/pedidos/pesaje', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items }),
      });
      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'No se pudo guardar el pesaje');
        return;
      }
      location.reload();
    }
  });
</script>

<style>
.panel-container { max-width: 900px; margin: 0 auto; padding: 20px; }
.filtros-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin-bottom: 20px;
}
.filtro-select {
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #ccc;
  font-size: 0.9rem;
  background: #fff;
}
.filtro-fecha {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  color: #555;
}
.filtro-fecha input {
  padding: 8px;
  border-radius: 8px;
  border: 1px solid #ccc;
  font-size: 0.9rem;
}
.btn-filtrar {
  padding: 10px 16px;
  border-radius: 8px;
  border: 1px solid #30af25;
  background: #30af25;
  color: #fff;
  cursor: pointer;
  font-size: 0.9rem;
}
.btn-filtrar:hover { opacity: 0.9; }
.btn-limpiar-filtros {
  padding: 10px 16px;
  border-radius: 8px;
  border: 1px solid #ccc;
  background: #fff;
  color: #666;
  font-size: 0.9rem;
  text-decoration: none;
}
.btn-limpiar-filtros:hover { background: #f4f7fb; }
.sin-pedidos { text-align: center; color: #888; padding: 30px; }
.ruta-entrega { background: #fff9d6; border: 1px solid #e6d47a; border-radius: 10px; padding: 16px 20px; margin-bottom: 24px; }
.ruta-entrega ol { margin: 10px 0 0 20px; }
.pedidos-lista { display: flex; flex-direction: column; gap: 16px; }
.pedido-card { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 16px 20px; }
.pedido-card__header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.pedido-card__id { font-weight: bold; }
.pedido-card__estado { padding: 2px 10px; border-radius: 20px; font-size: 0.85rem; text-transform: capitalize; background: #eee; }
.pedido-card__estado--pendiente { background: #ffe0b2; }
.pedido-card__estado--en_preparacion { background: #fff9c4; }
.pedido-card__estado--en_ruta { background: #bbdefb; }
.pedido-card__estado--entregado { background: #c8e6c9; }
.pedido-card__items { margin: 10px 0; padding: 10px 0; border-top: 1px dashed #ddd; border-bottom: 1px dashed #ddd; }
.item-pesaje { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 4px 0; flex-wrap: wrap; }
.pesaje-input { display: flex; align-items: center; gap: 6px; }
.input-cantidad-real { width: 80px; padding: 4px; border-radius: 4px; border: 1px solid #ccc; }
.btn-guardar-pesaje { margin-top: 8px; padding: 6px 12px; border-radius: 6px; border: 1px solid #999; background: #f5f5f5; cursor: pointer; }
.pedido-card__total { font-weight: bold; font-size: 1.05rem; }
.pedido-card__acciones { display: flex; gap: 8px; margin-top: 10px; }
.btn-estado { flex: 1; padding: 8px; border: 1px solid #ccc; border-radius: 6px; background: #f5f5f5; cursor: pointer; }
.btn-estado:hover { background: #e8e8e8; }
</style>