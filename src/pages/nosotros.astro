---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { pool } from "../lib/db.js";
import { obtenerResumenAtencion, obtenerResenasAtencionAprobadas } from "../lib/resenas.js";

export const prerender = false;

const BASE_CLIENTES_FELICES = 28670;
const [[{ total: totalClientes }]] = await pool.query('SELECT COUNT(*) AS total FROM clientes');
const clientesFelices = BASE_CLIENTES_FELICES + Number(totalClientes);

const resumenAtencion = await obtenerResumenAtencion();
const testimonios = await obtenerResenasAtencionAprobadas(6);

function formatearFechaTestimonio(fecha) {
  return new Date(fecha).toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<MainLayout title="Nosotros">

<Navbar />

<div class="background">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
</div>

<section class="hero">

    <h1>Sobre Nosotros</h1>

    <p>
        En Don Ciro trabajamos día a día para ofrecer productos lácteos,
        quesos y abarrotes de la mejor calidad, entregando confianza,
        frescura y tradición a cada uno de nuestros clientes.
    </p>

</section>

<section class="historia">

<div class="card grande">

<h2>📚 Nuestra Historia</h2>

<p>

Don Ciro nace con el objetivo de acercar productos frescos y de calidad a las familias chilenas. Nuestro compromiso siempre ha sido entregar el mejor servicio y mantener la confianza de nuestros clientes.

</p>

</div>

</section>

<section class="misionVision">

<div class="card">

<h2>🎯 Misión</h2>

<p>
Brindar productos frescos y de excelente calidad con una atención cercana y responsable.
</p>

</div>

<div class="card">

<h2>🚀 Visión</h2>

<p>
Ser reconocidos como una empresa líder por la calidad de nuestros productos y el compromiso con nuestros clientes.
</p>

</div>

</section>

<section class="valores">

<h2>Nuestros Valores</h2>

<div class="contenedor">

<div class="valor">
🌿
<h3>Calidad</h3>
</div>

<div class="valor">
🤝
<h3>Compromiso</h3>
</div>

<div class="valor">
🧀
<h3>Tradición</h3>
</div>

<div class="valor">
❤️
<h3>Confianza</h3>
</div>

</div>

</section>

<section class="estadisticas">

<div class="numero">
<h2>+{clientesFelices.toLocaleString('es-CL')}</h2>
<p>Clientes felices</p>
</div>

<div class="numero">
<h2>+130</h2>
<p>Productos</p>
</div>

<div class="numero">
<h2>100%</h2>
<p>Calidad</p>
</div>

{resumenAtencion.total > 0 && (
  <div class="numero">
    <h2>⭐ {resumenAtencion.promedio}</h2>
    <p>Satisfacción ({resumenAtencion.total} opiniones)</p>
  </div>
)}

</section>

<section class="testimonios">

<h2>Lo que dicen nuestros clientes</h2>

{testimonios.length === 0 ? (
  <p class="testimonios__vacio">Todavía no tenemos reseñas publicadas. ¡Sé el primero en dejar tu opinión después de tu compra!</p>
) : (
  <div class="testimonios__grid">
    {testimonios.map((t) => (
      <div class="testimonio">
        <span class="testimonio__estrellas">{'★'.repeat(t.calificacion)}{'☆'.repeat(5 - t.calificacion)}</span>
        {t.comentario && <p class="testimonio__comentario">"{t.comentario}"</p>}
        <p class="testimonio__autor">{t.cliente} · {formatearFechaTestimonio(t.created_at)}</p>
      </div>
    ))}
  </div>
)}

<p class="testimonios__nota">
  ¿Ya compraste con nosotros? Puedes calificar tus productos desde <a href="/producto">Productos</a> y la atención recibida desde <a href="/mis-pedidos">Mis pedidos</a>.
</p>

</section>

<Footer />

</MainLayout>


<style>
    body{
    overflow-x:hidden;
}

.background{
    position:fixed;
    inset:0;
    z-index:-1;
    overflow:hidden;
    background:linear-gradient(135deg,#EAF4F3,#D5E7ED);
}

.background span{
    position:absolute;
    bottom:-150px;
    border-radius:50%;
    background:rgba(42,161,152,.15);
    animation:subir 20s linear infinite;
}

.background span:nth-child(1){width:120px;height:120px;left:5%;}
.background span:nth-child(2){width:80px;height:80px;left:18%;animation-duration:16s;}
.background span:nth-child(3){width:160px;height:160px;left:35%;}
.background span:nth-child(4){width:70px;height:70px;left:55%;animation-duration:15s;}
.background span:nth-child(5){width:180px;height:180px;left:70%;}
.background span:nth-child(6){width:90px;height:90px;left:82%;}
.background span:nth-child(7){width:140px;height:140px;left:92%;}
.background span:nth-child(8){width:110px;height:110px;left:45%;}

@keyframes subir{

from{
transform:translateY(0) rotate(0deg);
}

to{
transform:translateY(-120vh) rotate(360deg);
}

}

.hero{

padding:90px 20px;
text-align:center;

}

.hero h1{

font-size:clamp(1.8rem, 6vw, 4rem);
color:var(--crema);
background:linear-gradient(135deg, var(--azul-dark), var(--azul));
display:inline-block;
padding:0.22em 0.7em 0.3em;
border-radius:0.22em;
box-shadow:0 12px 28px rgba(8,43,74,.24);
margin-bottom:20px;

}

.hero p{

max-width:900px;
margin:auto;
font-size:clamp(1rem, 3vw, 1.3rem);

}

.historia{

padding:30px;

}

.card{

background:var(--crema);
border:1px solid var(--azul-linea);
padding:35px;
border-radius:25px;
box-shadow:0 15px 40px rgba(0,0,0,.15);
transition:.4s;

}

.card:hover{

transform:translateY(-10px);

}

.grande{

max-width:1100px;
margin:auto;

}

.misionVision{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:30px;
padding:40px;

}

.valores{

text-align:center;
padding:60px 20px;

}

.contenedor{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
gap:25px;
margin-top:40px;

}

.valor{

background:var(--crema);
border:1px solid var(--azul-linea);
padding:35px;
border-radius:20px;
font-size:clamp(32px, 8vw, 55px);
transition:.4s;
cursor:pointer;
box-shadow:0 10px 25px rgba(0,0,0,.15);

}

.valor h3{
    font-size: clamp(22px, 5vw, 50px);
}

.valor:hover{

transform:scale(1.08) rotate(4deg);

}

.estadisticas{

display:flex;
justify-content:center;
gap:60px;
flex-wrap:wrap;
padding:80px 20px;

}

.numero{

background:linear-gradient(135deg, var(--azul), var(--azul-acento));
color:white;
padding:30px;
width:220px;
border-radius:20px;
transition:.4s;
text-align: center;
}

.numero h2{

font-size:2rem;

}

@media (max-width: 600px) {
  .estadisticas {
    gap: 20px;
    padding: 50px 15px;
  }

  .numero {
    width: 100%;
    max-width: 260px;
    padding: 20px;
  }

  .misionVision {
    padding: 20px;
  }
}

.testimonios {
  padding: 60px 20px 90px;
  text-align: center;
  max-width: 1100px;
  margin: 0 auto;
}

.testimonios h2 {
  font-size: clamp(1.5rem, 5vw, 2.2rem);
  color: var(--azul-dark);
  margin-bottom: 30px;
}

.testimonios__vacio {
  color: #666;
  font-size: 1rem;
}

.testimonios__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
  text-align: left;
}

.testimonio {
  background: var(--crema);
  border: 1px solid var(--azul-linea);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  transition: 0.3s;
}

.testimonio:hover {
  transform: translateY(-6px);
}

.testimonio__estrellas {
  color: #d9a441;
  font-size: 1.1rem;
  letter-spacing: 2px;
}

.testimonio__comentario {
  margin: 12px 0;
  font-style: italic;
  color: var(--ink, #333);
}

.testimonio__autor {
  font-size: 0.85rem;
  font-weight: 600;
  color: #666;
  margin: 0;
}

.testimonios__nota {
  margin-top: 40px;
  font-size: 0.9rem;
  color: #666;
}

.testimonios__nota a {
  color: var(--azul, #2874a6);
  font-weight: 600;
  text-decoration: none;
}

.testimonios__nota a:hover {
  text-decoration: underline;
}

</style>