---
import Layout from '../layouts/MainLayout.astro';
import PanelNavbar from '../components/PanelNavbar.astro';
import Footer from '../components/Footer.astro';
import { estaAutorizado } from '../lib/auth.js';
import { obtenerResenasProductoAdmin, obtenerResenasAtencionAdmin } from '../lib/resenas.js';

export const prerender = false;

const autorizado = estaAutorizado(Astro.request);

if (!autorizado) {
  Astro.response.status = 401;
  Astro.response.headers.set('WWW-Authenticate', 'Basic realm="Panel proveedor"');
}

let resenasProducto = [];
let resenasAtencion = [];
if (autorizado) {
  [resenasProducto, resenasAtencion] = await Promise.all([
    obtenerResenasProductoAdmin(),
    obtenerResenasAtencionAdmin(),
  ]);
}

function formatearFecha(fecha) {
  return new Date(fecha).toLocaleString('es-CL', {
    day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit',
  });
}
---
<Layout title="Reseñas - Panel proveedor">
  {!autorizado ? (
    <p style="text-align:center; margin:60px;">Acceso restringido.</p>
  ) : (
    <>
      <PanelNavbar />
      <main class="panel-resenas">
        <h1 class="titulo-seccion">Reseñas y calificaciones</h1>

        <section class="bloque-resenas">
          <h2>Productos</h2>
          <div class="tabla-resenas" id="tabla-producto">
            {resenasProducto.length === 0 ? (
              <p class="sin-resenas">Todavía no hay reseñas de productos.</p>
            ) : (
              resenasProducto.map((r) => (
                <article class={`resena-card resena-card--${r.estado}`} data-tipo="producto" data-id={r.id}>
                  <div class="resena-card__header">
                    <strong>{r.producto}</strong>
                    <span class="resena-estrellas">{'★'.repeat(r.calificacion)}{'☆'.repeat(5 - r.calificacion)}</span>
                    <span class={`resena-badge resena-badge--${r.estado}`}>{r.estado}</span>
                  </div>
                  <p class="resena-card__meta">{r.cliente} · {formatearFecha(r.created_at)}</p>
                  {r.comentario && <p class="resena-card__comentario">{r.comentario}</p>}
                  <div class="resena-card__acciones">
                    {r.estado !== 'aprobada' && <button class="btn-aprobar" type="button">Aprobar</button>}
                    {r.estado !== 'rechazada' && <button class="btn-rechazar" type="button">Rechazar</button>}
                    <button class="btn-eliminar" type="button">Eliminar</button>
                  </div>
                </article>
              ))
            )}
          </div>
        </section>

        <section class="bloque-resenas">
          <h2>Atención al cliente</h2>
          <div class="tabla-resenas" id="tabla-atencion">
            {resenasAtencion.length === 0 ? (
              <p class="sin-resenas">Todavía no hay reseñas de atención al cliente.</p>
            ) : (
              resenasAtencion.map((r) => (
                <article class={`resena-card resena-card--${r.estado}`} data-tipo="atencion" data-id={r.id}>
                  <div class="resena-card__header">
                    <strong>Pedido #{r.pedido_id}</strong>
                    <span class="resena-estrellas">{'★'.repeat(r.calificacion)}{'☆'.repeat(5 - r.calificacion)}</span>
                    <span class={`resena-badge resena-badge--${r.estado}`}>{r.estado}</span>
                  </div>
                  <p class="resena-card__meta">{r.cliente} · {formatearFecha(r.created_at)}</p>
                  {r.comentario && <p class="resena-card__comentario">{r.comentario}</p>}
                  <div class="resena-card__acciones">
                    {r.estado !== 'aprobada' && <button class="btn-aprobar" type="button">Aprobar</button>}
                    {r.estado !== 'rechazada' && <button class="btn-rechazar" type="button">Rechazar</button>}
                    <button class="btn-eliminar" type="button">Eliminar</button>
                  </div>
                </article>
              ))
            )}
          </div>
        </section>
      </main>
      <Footer />
    </>
  )}
</Layout>

<script>
  document.addEventListener('click', async (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;
    const card = target.closest('.resena-card');
    if (!card) return;

    const tipo = card.dataset.tipo;
    const id = Number(card.dataset.id);

    if (target.classList.contains('btn-aprobar') || target.classList.contains('btn-rechazar')) {
      const estado = target.classList.contains('btn-aprobar') ? 'aprobada' : 'rechazada';
      const res = await fetch('/api/resenas/admin', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo, id, estado }),
      });
      if (res.ok) {
        location.reload();
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'No se pudo actualizar la reseña.');
      }
      return;
    }

    if (target.classList.contains('btn-eliminar')) {
      if (!confirm('¿Eliminar esta reseña? Esta acción no se puede deshacer.')) return;
      const res = await fetch('/api/resenas/admin', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo, id }),
      });
      if (res.ok) {
        card.remove();
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'No se pudo eliminar la reseña.');
      }
    }
  });
</script>

<style>
.panel-resenas {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px 20px 60px;
}
.bloque-resenas {
  margin-top: 2rem;
}
.bloque-resenas h2 {
  font-size: 1.2rem;
  margin-bottom: 12px;
  color: var(--azul-dark);
}
.sin-resenas {
  color: #777;
  font-size: 0.9rem;
}
.tabla-resenas {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.resena-card {
  border: 1px solid #e3e8f0;
  border-radius: 12px;
  padding: 14px 16px;
  background: #f9fafb;
}
.resena-card--pendiente {
  border-left: 4px solid #d9a441;
}
.resena-card--aprobada {
  border-left: 4px solid #3a9d5d;
}
.resena-card--rechazada {
  border-left: 4px solid #c14545;
  opacity: 0.75;
}
.resena-card__header {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.resena-estrellas {
  color: #d9a441;
  letter-spacing: 1px;
}
.resena-badge {
  margin-left: auto;
  font-size: 0.75rem;
  padding: 2px 10px;
  border-radius: 999px;
  text-transform: capitalize;
}
.resena-badge--pendiente { background: #fbe9c9; color: #7a5a12; }
.resena-badge--aprobada { background: #d7f0dd; color: #1f6b3a; }
.resena-badge--rechazada { background: #f5d6d6; color: #8a2222; }
.resena-card__meta {
  font-size: 0.82rem;
  color: #666;
  margin: 6px 0 0;
}
.resena-card__comentario {
  margin: 8px 0 0;
  font-size: 0.95rem;
}
.resena-card__acciones {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.resena-card__acciones button {
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 0.85rem;
  cursor: pointer;
}
.btn-aprobar { background: #3a9d5d; color: #fff; }
.btn-rechazar { background: #d9a441; color: #fff; }
.btn-eliminar { background: #c14545; color: #fff; }
</style>
