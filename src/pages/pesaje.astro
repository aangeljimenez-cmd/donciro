---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { pool } from "../lib/db.js";

const [pendientes] = await pool.query(
  `SELECT dp.id AS detalle_id, dp.cantidad_solicitada, dp.pedido_id,
          p.name AS producto, pe.nombre_cliente, pe.email_cliente
   FROM detalle_pedido dp
   JOIN productos p ON dp.producto_id = p.id
   JOIN pedidos pe ON dp.pedido_id = pe.id
   WHERE dp.cantidad_real IS NULL
   ORDER BY dp.pedido_id`
);
---

<MainLayout title="Pesaje">
    <Navbar />
    <div class="pesaje-container">
        <h1 class="titulo-seccion">Pedidos pendientes de pesaje</h1>

        {pendientes.length === 0 ? (
            <p style="text-align:center; margin:40px;">No hay ítems pendientes de pesar 🎉</p>
        ) : (
            <div id="lista-pesaje">
                {pendientes.map((item) => (
                    <div class="pesaje-item" data-detalle-id={item.detalle_id}>
                        <div>
                            <strong>Pedido #{item.pedido_id}</strong> — {item.nombre_cliente} ({item.email_cliente})
                        </div>
                        <div>{item.producto} — pedido: {(item.cantidad_solicitada * 1000).toFixed(0)} gr</div>
                        <div class="pesaje-form">
                            <input type="number" class="input-gramos" placeholder="Peso real en gramos" min="1" />
                            <button class="btn-registrar-peso">Registrar peso</button>
                        </div>
                        <span class="pesaje-status"></span>
                    </div>
                ))}
            </div>
        )}
    </div>
    <Footer />
</MainLayout>

<script>
  document.addEventListener("click", async (e) => {
    if (!e.target.classList.contains("btn-registrar-peso")) return;

    const item = e.target.closest(".pesaje-item");
    const detalleId = Number(item.dataset.detalleId);
    const input = item.querySelector(".input-gramos");
    const status = item.querySelector(".pesaje-status");
    const gramos = Number(input.value);

    if (!gramos || gramos <= 0) {
      status.textContent = "Ingresa un peso válido";
      status.style.color = "red";
      return;
    }

    e.target.disabled = true;
    const res = await fetch("/api/pesaje", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ detalle_id: detalleId, gramos_reales: gramos }),
    });
    const data = await res.json();

    if (data.ok) {
      status.textContent = "✔ Registrado";
      status.style.color = "green";
      item.style.opacity = "0.5";
      input.disabled = true;
    } else {
      status.textContent = data.error || "Error al registrar";
      status.style.color = "red";
      e.target.disabled = false;
    }
  });
</script>

<style>
.pesaje-container { max-width: 700px; margin: 0 auto; padding: 20px; }
.pesaje-item {
    background: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 14px;
    box-shadow: 0 4px 12px rgba(0,0,0,.1);
}
.pesaje-form { display: flex; gap: 10px; margin-top: 10px; }
.input-gramos { flex: 1; padding: 8px; border-radius: 6px; border: 1px solid #ccc; }
.btn-registrar-peso {
    background: #30af25; color: white; border: none;
    padding: 8px 16px; border-radius: 6px; cursor: pointer;
}
.pesaje-status { display: block; margin-top: 6px; font-weight: bold; font-size: 0.9rem; }
</style>