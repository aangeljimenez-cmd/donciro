---
import Layout from '../layouts/MainLayout.astro';
import { obtenerPedidoPorCodigo } from '../lib/pedidos.js';

// Se busca por un código de seguimiento aleatorio, no por el id correlativo
// del pedido, para que nadie pueda ver el pedido de otra persona probando
// números consecutivos en la URL.
const codigo = Astro.url.searchParams.get('codigo');
const pedido = codigo ? await obtenerPedidoPorCodigo(codigo) : null;

const ESTADOS_LABEL = {
  pendiente: 'Pendiente',
  en_preparacion: 'En preparación',
  en_ruta: 'En ruta',
  entregado: 'Entregado',
};

function formatearMonto(monto) {
  return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP' }).format(monto);
}
---

<Layout title={pedido ? `Pedido #${pedido.id}` : 'Pedido no encontrado'}>
  <main class="seguimiento-page">
    {!pedido ? (
      <p>No encontramos ese pedido.</p>
    ) : (
      <>
        <h1>Pedido #{pedido.id}</h1>
        <p class="estado-badge">{ESTADOS_LABEL[pedido.estado] ?? pedido.estado}</p>

        <p><strong>Dirección de entrega:</strong> {pedido.direccion}</p>
        <p><strong>Teléfono:</strong> {pedido.telefono}</p>
        <p><strong>Fecha:</strong> {new Date(pedido.created_at).toLocaleString('es-CL')}</p>

        <div class="items-lista">
          {pedido.items.map((i) => (
            <div class="item-fila">
              <span>{i.producto_nombre}</span>
              <span>
                {i.unidad === 'kg' || i.unidad === 'litro'
                  ? `${(Number(i.cantidad) * 1000).toFixed(0)} g/ml`
                  : `${i.cantidad} un.`}
              </span>
              <span>{formatearMonto(i.subtotal)}</span>
            </div>
          ))}
        </div>

        <div class="totales">
          <p>Subtotal: {formatearMonto(pedido.subtotal)}</p>
          {Number(pedido.descuento_pct) > 0 && (
            <p>Descuento ({pedido.descuento_pct}%): -{formatearMonto(pedido.descuento_monto)}</p>
          )}
          <p class="total">Total: {formatearMonto(pedido.total)}</p>
        </div>
      </>
    )}
  </main>
</Layout>

<style>
  .seguimiento-page { max-width: 500px; margin: 0 auto; padding: 2rem 1rem; }
  .estado-badge {
    display: inline-block;
    background: var(--azul-suave);
    color: var(--azul-dark);
    border: 1px solid var(--azul-linea);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .items-lista { margin: 1rem 0; border-top: 1px dashed var(--azul-linea); border-bottom: 1px dashed var(--azul-linea); padding: 0.5rem 0; }
  .item-fila { display: flex; justify-content: space-between; padding: 4px 0; }
  .totales p { margin: 4px 0; }
  .total { font-weight: bold; font-size: 1.1rem; }
</style>
